---
type Props = {
	frontmatter?: { title?: string; description?: string };
	title?: string;
	description?: string;
};

const { frontmatter, title, description } = Astro.props as Props;
const pageTitle = frontmatter?.title ?? title ?? "Test Assignment";
const pageDescription =
	frontmatter?.description ??
	description ??
	"Mini attendance app — take-home assignment.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%8F%B1%3C/text%3E%3C/svg%3E" />
	</head>
	<body>
		<main class="prose">
			<slot />
		</main>
		<style is:global>
			:root {
				--fg: #1a1a1a;
				--bg: #fafaf7;
				--muted: #5a5a5a;
				--accent: #2563eb;
				--code-bg: #efede7;
				--border: #d8d6cf;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--fg: #ededed;
					--bg: #0e0e0e;
					--muted: #9a9a9a;
					--accent: #6ea8fe;
					--code-bg: #1a1a1a;
					--border: #262626;
				}
			}
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			html {
				-webkit-text-size-adjust: 100%;
			}
			body {
				margin: 0;
				background: var(--bg);
				color: var(--fg);
				font-family:
					-apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto,
					"Helvetica Neue", Arial, sans-serif;
				font-size: 17px;
				line-height: 1.65;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}
			.prose {
				max-width: 760px;
				margin: 0 auto;
				padding: 64px 24px 96px;
			}
			.prose h1 {
				font-size: 2.1rem;
				line-height: 1.2;
				margin: 0 0 1rem;
				letter-spacing: -0.02em;
			}
			.prose h2 {
				font-size: 1.35rem;
				line-height: 1.3;
				margin: 3rem 0 1rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border);
				letter-spacing: -0.01em;
			}
			.prose h3 {
				font-size: 1.1rem;
				margin: 1.8rem 0 0.6rem;
			}
			.prose p {
				margin: 1rem 0;
			}
			.prose a {
				color: var(--accent);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
			}
			.prose a:hover {
				text-decoration-thickness: 2px;
			}
			.prose code {
				background: var(--code-bg);
				padding: 0.1em 0.4em;
				border-radius: 4px;
				font-size: 0.88em;
				font-family:
					ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
			}
			.prose pre {
				background: var(--code-bg);
				padding: 1rem 1.1rem;
				border-radius: 8px;
				overflow-x: auto;
				font-size: 0.88em;
				line-height: 1.55;
			}
			.prose pre code {
				background: transparent;
				padding: 0;
				font-size: 1em;
			}
			.prose ul,
			.prose ol {
				padding-left: 1.5rem;
				margin: 1rem 0;
			}
			.prose li {
				margin: 0.35rem 0;
			}
			.prose li > p {
				margin: 0.4rem 0;
			}
			.prose hr {
				border: 0;
				border-top: 1px solid var(--border);
				margin: 2.5rem 0;
			}
			.prose strong {
				font-weight: 600;
			}
			.prose blockquote {
				margin: 1rem 0;
				padding-left: 1rem;
				border-left: 3px solid var(--border);
				color: var(--muted);
			}
			::selection {
				background: var(--accent);
				color: #fff;
			}
		</style>
	</body>
</html>
